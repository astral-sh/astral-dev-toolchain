{
  "version": 2,
  "repositories": {
    "astral-dev-toolchain": {
      "name": "astral-sh/astral-dev-toolchain",
      "id": 1341197863,
      "oidc_subject": "immutable",
      "owner_id": 115962839
    }
  },
  "rules": [
    {
      "caller": "astral-dev-toolchain",
      "environment": "automations",
      "caller_ref": "refs/pull/*/merge",
      "caller_workflow": "ci.yml",
      "reusable_workflow": "astral-sh/github-actions/.github/workflows/pull-request-security-review.yml@6a612d86f84507386fc1e361e3fda194351ceadd",
      "on": ["pull_request"],
      "permissions": { "pull_requests": "write" },
      "target": "astral-dev-toolchain"
    },
    {
      "caller": "astral-dev-toolchain",
      "environment": "automations",
      "caller_workflow": "toolchain-update.yml",
      "on": ["schedule", "workflow_dispatch"],
      "permissions": { "contents": "write", "pull_requests": "write" },
      "target": "astral-dev-toolchain"
    }
  ]
}
